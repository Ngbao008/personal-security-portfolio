---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import LabCard from "../components/LabCard.astro";
import BlogCard from "../components/BlogCard.astro";
import { withBase } from "../utils/paths";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => !import.meta.env.PROD || !project.data.draft)
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const socialLabels = {
  github: "GitHub",
  linkedin: "LinkedIn",
  tryhackme: "TryHackMe",
  hackthebox: "Hack The Box",
};
const socialLinks = Object.entries(site.social).filter(([key, url]) => key !== "email" && url && !url.startsWith("TODO"));
const featuredLabs = (await getCollection("lab"))
  .filter((lab) => !import.meta.env.PROD || !lab.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const latestPosts = (await getCollection("blog"))
  .filter((post) => !import.meta.env.PROD || !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title={site.title} description={site.tagline} showPersonSchema>
  <section class="hero section">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">// personal security portfolio</p>
        <h1>{site.name}</h1>
        <p class="hero-title">{site.title}</p>
        <p class="hero-copy">{site.tagline}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={withBase("/projects/")}>Xem Projects <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href={withBase(site.cvUrl)} download>Tải CV <span aria-hidden="true">↓</span></a>
        </div>
        <div class="social-links" aria-label="Liên kết mạng xã hội">
          {socialLinks.length > 0 ? (
            socialLinks.map(([key, url]) => <a href={url} rel="me noopener noreferrer" target="_blank">{socialLabels[key as keyof typeof socialLabels]}</a>)
          ) : (
            <span>TODO: Thêm liên kết mạng xã hội trong <code>src/data/site.ts</code>.</span>
          )}
        </div>
      </div>
      <aside class="terminal-card" aria-label="Thông tin nhanh">
        <div class="terminal-header"><span></span><span></span><span></span><code>profile.json</code></div>
        <pre><code>{`{
  "role": "${site.title}",
  "location": "${site.location}",
  "status": "learning",
  "focus": ["${site.careerFocus.join('", "')}"]
}`}</code></pre>
      </aside>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <p class="eyebrow">focus areas</p>
      <h2>Điều mình đang theo đuổi</h2>
      <div class="tag-list">
        {site.careerFocus.map((focus) => <span class="tag">{focus}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container section-heading">
      <div><p class="eyebrow">latest notes</p><h2>Bài viết mới nhất</h2></div>
      <a class="text-link" href={withBase("/blog/")}>Xem Blog →</a>
    </div>
    <div class="container narrow blog-list latest-posts">
      {latestPosts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>

  <section class="section">
    <div class="container section-heading">
      <div><p class="eyebrow">coming soon</p><h2>Featured projects</h2></div>
      <a class="text-link" href={withBase("/projects/")}>Xem tất cả →</a>
    </div>
    <div class="container project-grid featured-projects">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section section-muted">
    <div class="container section-heading">
      <div><p class="eyebrow">from the lab</p><h2>Tool học tập</h2></div>
      <a class="text-link" href={withBase("/lab/")}>Mở Lab →</a>
    </div>
    <div class="container lab-grid featured-labs">
      {featuredLabs.map((lab) => <LabCard lab={lab} />)}
    </div>
  </section>
</BaseLayout>

