---
import BaseLayout from "../layouts/BaseLayout.astro";
import { activities } from "../data/activities";

const kindLabels = {
  competition: "Cuộc thi",
  club: "Câu lạc bộ",
  event: "Sự kiện",
  volunteer: "Tình nguyện",
};
---

<BaseLayout title="Hoạt động" description="Hoạt động học tập và cộng đồng.">
  <section class="section page-hero">
    <div class="container narrow">
      <p class="eyebrow">activities</p>
      <h1>Hoạt động & trải nghiệm</h1>
      <p class="lead">Lọc nhanh theo loại hoạt động mà không cần tải lại trang.</p>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container narrow">
      <div class="filter-group" role="group" aria-label="Lọc hoạt động">
        <button class="filter-button active" type="button" aria-pressed="true" data-filter="all">Tất cả</button>
        {Object.entries(kindLabels).map(([kind, label]) => <button class="filter-button" type="button" aria-pressed="false" data-filter={kind}>{label}</button>)}
      </div>
      <ol class="timeline activity-list" data-activity-list>
        {activities.map((activity) => (
          <li data-kind={activity.kind}>
            <p class="timeline-date">{activity.date} · {kindLabels[activity.kind]}</p>
            <h2>{activity.title}</h2>
            {(activity.role || activity.org) && <p class="activity-meta">{[activity.role, activity.org].filter(Boolean).join(" · ")}</p>}
            {activity.description && <p>{activity.description}</p>}
            {activity.result && <p class="activity-result">{activity.result}</p>}
            {activity.link && <a class="text-link" href={activity.link} target="_blank" rel="noopener noreferrer">Xem thêm ↗</a>}
          </li>
        ))}
      </ol>
      <p class="empty-filter" hidden data-empty-filter>Chưa có hoạt động phù hợp.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-activity-list] > li");
  const emptyMessage = document.querySelector<HTMLElement>("[data-empty-filter]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      let visibleCount = 0;

      items.forEach((item) => {
        const isVisible = filter === "all" || item.dataset.kind === filter;
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      filterButtons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle("active", isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });
      if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
    });
  });
</script>

