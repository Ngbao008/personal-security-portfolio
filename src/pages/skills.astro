---
import BaseLayout from "../layouts/BaseLayout.astro";
import { skillGroups } from "../data/skills";
---

<BaseLayout title="Kỹ năng" description="Các kỹ năng đang phát triển.">
  <section class="section page-hero">
    <div class="container narrow">
      <p class="eyebrow">skill set</p>
      <h1>Kỹ năng đang phát triển</h1>
      <p class="lead">Danh sách này được cập nhật từ một tệp dữ liệu duy nhất để bạn chỉnh sửa dễ dàng.</p>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container skill-groups">
      {skillGroups.map((group) => (
        <article class="content-card">
          <h2>{group.group}</h2>
          <ul class="skill-list">
            {group.items.map((skill) => (
              <li>
                <span class="skill-name">{skill.name}</span>
                {skill.level && (
                  <span class="skill-level" aria-label={`Mức độ tự đánh giá: ${skill.level} trên 5`}>
                    {Array.from({ length: 5 }, (_, index) => <i class:list={{ active: index < (skill.level ?? 0) }} aria-hidden="true"></i>)}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

