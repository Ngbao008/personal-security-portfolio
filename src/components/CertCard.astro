---
import type { Cert } from "../data/certs";

interface Props {
  cert: Cert;
}

const { cert } = Astro.props;
---

<article class="content-card cert-card">
  <span class:list={["status-badge", cert.status]}>{cert.status === "earned" ? "Đã đạt" : "Đang học"}</span>
  <h3>{cert.name}</h3>
  <p>{cert.issuer}</p>
  <p class="card-meta">{cert.date}</p>
  {cert.credentialUrl && <a class="text-link" href={cert.credentialUrl} target="_blank" rel="noopener noreferrer">Xác minh ↗</a>}
</article>

